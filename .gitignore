# Python bytecode — the CLI and lib/ scripts are run directly, never packaged,
# so these are pure build noise (and install.py skips them when copying).
__pycache__/
*.py[cod]

# Local assistant/editor state — personal, not part of the project
.claude/settings.local.json

# Local editor/tool state
.venv/
venv/
.DS_Store

# Test/coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
